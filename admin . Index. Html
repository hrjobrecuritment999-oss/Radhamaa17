<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>RDM Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../css/style.css">
</head>
<body style="background:var(--bg);min-height:100vh">
<header class="top"><div class="wrap">
  <div class="brand"><span class="logo"><img src="../assets/logo.png" alt="" onerror="this.remove()"><b>RDM</b><small>EXIM</small></span>Admin</div>
  <div><a class="btn line" style="padding:8px 16px" href="../index.html" target="_blank">View site</a>
  <button class="btn gold" id="logoutBtn" style="padding:9px 18px;display:none">Logout</button></div>
</div></header>

<div class="wrap" style="padding-bottom:80px">

<!-- LOGIN -->
<div id="loginView" class="panel" style="max-width:420px;margin:60px auto">
  <h2 style="font-size:1.8rem">Admin login</h2>
  <form id="loginForm">
    <label>Email</label><input type="email" name="email" required>
    <label>Password</label><input type="password" name="password" required>
    <button class="btn blue" style="width:100%;margin-top:22px">Login</button>
    <div class="err" id="loginErr"></div>
  </form>
</div>

<!-- APP -->
<div id="appView" style="display:none">
  <div class="tabs">
    <button data-tab="categories" class="on">Categories</button>
    <button data-tab="products">Products</button>
    <button data-tab="inquiries">Inquiries</button>
  </div>

  <div id="tab-categories">
    <div class="panel" style="margin-top:0">
      <h3 id="catFormTitle">Add category</h3>
      <form id="catForm">
        <input type="hidden" name="id">
        <div class="grid2">
          <div><label>Name</label><input name="name" required placeholder="e.g. Spices"></div>
          <div><label>HS code</label><input name="hs_code" placeholder="e.g. HS 09"></div>
        </div>
        <label>Description</label><input name="description">
        <div class="grid2">
          <div><label>Packing</label><input name="packing" placeholder="e.g. 1 kg to 25 kg packs"></div>
          <div><label>Order (number)</label><input name="sort_order" type="number" value="0"></div>
        </div>
        <label>Banner image (optional)</label><input type="file" name="image" accept="image/*">
        <div style="margin-top:20px;display:flex;gap:10px">
          <button class="btn blue">Save</button>
          <button type="button" class="btn sm" id="catCancel">Clear</button>
        </div>
      </form>
    </div>
    <div id="catList" style="margin-top:20px"></div>
  </div>

  <div id="tab-products" style="display:none">
    <div class="panel" style="margin-top:0">
      <h3 id="prodFormTitle">Add product</h3>
      <form id="prodForm">
        <input type="hidden" name="id"><input type="hidden" name="image_url">
        <div class="grid2">
          <div><label>Category</label><select name="category_id" id="prodCat" required></select></div>
          <div><label>Product name</label><input name="name" required placeholder="e.g. Cardamom"></div>
        </div>
        <label>Short description (optional)</label><input name="description">
        <div class="grid2">
          <div><label>Photo (optional)</label><input type="file" name="image" accept="image/*"></div>
          <div><label>Order (number)</label><input name="sort_order" type="number" value="0"></div>
        </div>
        <label style="text-transform:none;letter-spacing:0;display:flex;gap:8px;align-items:center;font-size:1rem">
          <input type="checkbox" name="active" checked style="width:auto"> Show on website</label>
        <div style="margin-top:20px;display:flex;gap:10px">
          <button class="btn blue">Save</button>
          <button type="button" class="btn sm" id="prodCancel">Clear</button>
        </div>
      </form>
    </div>
    <div id="prodList" style="margin-top:20px"></div>
  </div>

  <div id="tab-inquiries" style="display:none"><div id="inqList"></div></div>
  <div class="ok" id="toast" style="position:fixed;bottom:20px;left:20px;right:20px;max-width:400px;margin:auto"></div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="../js/config.js"></script>
<script src="../js/supabase-client.js"></script>
<script src="admin.js"></script>

</body>
</html>
